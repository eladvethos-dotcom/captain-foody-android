<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+: back up only the saved tours and places (WebView local storage),
  and only to an end-to-end encrypted Google backup. Nothing else leaves the device.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="root" path="app_webview/Default/Local Storage/" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_webview/Default/Local Storage/" />
    </device-transfer>
</data-extraction-rules>
